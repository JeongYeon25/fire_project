# .env.example 를 .env 로 복사한 뒤 값을 채우세요.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# 접속을 허용할 주소(쉼표로 구분). 앞에 점을 붙이면 모든 하위 주소: .trycloudflare.com = cloudflared 임시 링크
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.trycloudflare.com
# https 임시 링크에서 웹 화면 로그인·저장 폼을 쓰려면 필요 (센서 수신 API는 없어도 됨)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# 내 기기 화면의 전송 주소 앞부분(비우면 접속한 주소). 예: https://abc.trycloudflare.com
PUBLIC_BASE_URL=
# https 프록시(cloudflared) 뒤에서만 1. X-Forwarded-Proto를 믿어 전송 주소를 https로 만든다
DJANGO_TRUST_FORWARDED_PROTO=

# 식물 상담소. 셋 다 있어야 켜진다(없으면 "식물 상담소는 준비 중이에요"). 지금 지원: openai
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# 선택: 응답 기다리는 시간(초, 기본 20), 출력 한도(추론 포함, 기본 1000), 추론 강도(기본 low, 비우면 안 보냄)
LLM_TIMEOUT_SECONDS=
LLM_MAX_OUTPUT_TOKENS=
LLM_REASONING_EFFORT=
# 하루 질문 한도(서울 날짜). 0이나 빈칸이면 제한 없음. 사용자당 / 서비스 전체
CHAT_DAILY_LIMIT=
CHAT_GLOBAL_DAILY_LIMIT=

# 예전 pi-01 기기 키. 기기 키는 이제 DB(해시)에 있다 — `python manage.py adopt_env_device_keys`로 옮긴 뒤 지워도 된다
SENSOR_KEY_PI01=
# 조도 센서를 BH1750(lux)으로 바꾼 시각(서울). 비워 두면 빛 판정을 하지 않는다. 예: 2026-11-01T00:00:00
LIGHT_LUX_SINCE=
# 센서 교정 구간 끝(서울). 이 시각 이전 행은 원시값만 저장하고 화분 값은 만들지 않는다. 비워 두면 기본값 사용
SENSOR_IGNORE_BEFORE=
